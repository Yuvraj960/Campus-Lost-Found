NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus-lost-found
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: restrict registration, e.g. university.edu (leave blank to allow all)
ALLOWED_EMAIL_DOMAIN=
# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Gemini (AI matching + assistant). Blank = heuristic fallback matcher
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MATCH_THRESHOLD=75
FALLBACK_MATCH_THRESHOLD=60
# Seed admin
ADMIN_EMAIL=admin@campus.test
ADMIN_PASSWORD=Admin@12345
